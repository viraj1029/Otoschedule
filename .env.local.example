# Vercel Postgres connection string (injected automatically on Vercel)
# For local dev, get this from your Vercel project dashboard → Storage → your DB → .env.local
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# A long random string used to encrypt session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
